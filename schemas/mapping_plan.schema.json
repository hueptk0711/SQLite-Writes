{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nldbwrite-v3/mapping-plan.schema.json",
  "title": "Mapping-first Write Plan",
  "type": "object",
  "required": ["target_groups", "dependencies", "ignored_fields"],
  "additionalProperties": false,
  "properties": {
    "target_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "source_collection",
          "table",
          "source_rows",
          "field_mapping",
          "constants",
          "action",
          "conflict"
        ],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "source_collection": {"type": "string", "minLength": 1},
          "table": {"type": "string", "minLength": 1},
          "source_rows": {"type": "string"},
          "source_row_indices": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0},
            "uniqueItems": true
          },
          "field_mapping": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "constants": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["value", "evidence"],
              "additionalProperties": false,
              "properties": {
                "value": {},
                "evidence": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["source", "exact_span"],
                      "additionalProperties": false,
                      "properties": {
                        "source": {"const": "instruction_text"},
                        "exact_span": {"type": "string", "minLength": 1}
                      }
                    },
                    {
                      "type": "object",
                      "required": ["source"],
                      "additionalProperties": false,
                      "properties": {
                        "source": {"const": "schema_default"}
                      }
                    }
                  ]
                }
              }
            }
          },
          "action": {"const": "insert"},
          "conflict": {"$ref": "#/$defs/conflict"}
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependency"}
    },
    "ignored_fields": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        ]
      }
    }
  },
  "$defs": {
    "conflict": {
      "type": "object",
      "required": ["action", "target", "update_columns"],
      "properties": {
        "action": {
          "enum": ["error", "do_nothing", "do_update"]
        },
        "target": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "update_columns": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["before", "after"],
      "additionalProperties": false,
      "properties": {
        "before": {"type": "string"},
        "after": {"type": "string"},
        "foreign_key": {"type": "object"}
      }
    }
  }
}
