{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nldbwrite-v4/mapping-plan-plus.schema.json",
  "title": "MP-FS+ Reference Mapping Plan",
  "type": "object",
  "required": ["target_groups", "dependencies", "ignored_fields"],
  "additionalProperties": false,
  "properties": {
    "target_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "source_collection_id",
          "source_selector_id",
          "table_id",
          "field_mapping",
          "constants",
          "write_semantics",
          "conflict_target_id",
          "update_column_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "source_collection_id": {"type": "string", "minLength": 1},
          "source_selector_id": {"type": "string", "minLength": 1},
          "table_id": {"type": "string", "minLength": 1},
          "field_mapping": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "constants": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["value", "evidence"],
              "additionalProperties": false,
              "properties": {
                "value": {},
                "evidence": {
                  "type": "object",
                  "required": ["source", "exact_span"],
                  "additionalProperties": false,
                  "properties": {
                    "source": {"const": "instruction_text"},
                    "exact_span": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          },
          "write_semantics": {
            "enum": [
              "plain_insert",
              "insert_ignore",
              "upsert_update",
              "needs_clarification"
            ]
          },
          "conflict_target_id": {
            "type": ["string", "null"]
          },
          "update_column_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["before", "after"],
        "additionalProperties": false,
        "properties": {
          "before": {"type": "string", "minLength": 1},
          "after": {"type": "string", "minLength": 1}
        }
      }
    },
    "ignored_fields": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        ]
      }
    }
  }
}
