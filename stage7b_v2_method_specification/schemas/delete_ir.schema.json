{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "const": "DELETE"
    },
    "row_selector": {
      "additionalProperties": false,
      "properties": {
        "connector": {
          "enum": [
            "AND",
            "OR"
          ]
        },
        "predicates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "column_ref": {
                "enum": [
                  "COL_1",
                  "COL_2",
                  "COL_3",
                  "COL_4",
                  "COL_5"
                ],
                "type": "string"
              },
              "evidence_ref": {
                "enum": [
                  "EV_1",
                  "EV_2",
                  "EV_3"
                ],
                "type": "string"
              },
              "operator": {
                "enum": [
                  "EQ",
                  "NE",
                  "LT",
                  "GT"
                ]
              },
              "slot_ref": {
                "enum": [
                  "SLOT_1",
                  "SLOT_2",
                  "SLOT_3"
                ],
                "type": "string"
              }
            },
            "required": [
              "column_ref",
              "operator",
              "evidence_ref",
              "slot_ref"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "connector",
        "predicates"
      ],
      "type": "object",
      "x-semantic-constraints": {
        "predicate_column_uniqueness_required": false,
        "predicate_slot_ref_multiplicity": "slot_ref values must be unique within predicates"
      }
