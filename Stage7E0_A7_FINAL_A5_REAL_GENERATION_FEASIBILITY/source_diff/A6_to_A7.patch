-def _sequence_status(text: str, pos: int, parts: list[Any]) -> list[tuple[str, int]]:
-    states = [("complete", pos)]
-    for part in parts:
-        next_states: list[tuple[str, int]] = []
-        for _status, state_pos in states:
-            if isinstance(part, str):
