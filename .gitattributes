* text=auto
*.zip binary
*.gz binary
*.tar binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary

# Keep Stage-3 replay artifacts byte-stable across Windows/Linux checkouts.
stage3_full_causal_replay/** text eol=lf
stage3b_final_component_selection/** text eol=lf
stage4_fresh_7b_protocol/** text eol=lf
stage4_fresh_7b_protocol/validation/*.txt text eol=crlf
stage4_fresh_7b_protocol/validation/deterministic_repeat.txt text eol=lf

# Keep hash-frozen dependency locks and method configs byte-stable on Windows.
requirements-inference.lock.txt text eol=lf
configs/stage3b/*.json text eol=lf
configs/stage4/*.json text eol=lf
