      "mode": "semi_structured",
      "input": "REQUEST: Add the listed majors.\nSOURCE: c1/s1 at $[*], c1.f1=major code, c1.f2=major name.\nDATA: [{\"major code\":\"DS\",\"major name\":\"Data Science\"}]\nDEMO SCHEMA: t1=majors; t1.c1=major_id; t1.c2=major_name; t1.u1=PRIMARY KEY(t1.c1).",
      "outputs": {
        "direct": "INSERT INTO majors(major_id, major_name) VALUES ('DS', 'Data Science');",
        "record": "{\"records\":[{\"table\":\"majors\",\"operation\":\"insert\",\"values\":{\"major_id\":\"DS\",\"major_name\":\"Data Science\"}}]}",
        "mapping_legacy": "{\"target_groups\":[{\"group_id\":\"g1\",\"source_collection\":\"collection_1\",\"source_rows\":\"$[*]\",\"table\":\"majors\",\"field_mapping\":{\"major code\":\"major_id\",\"major name\":\"major_name\"},\"constants\":{},\"action\":\"insert\",\"conflict\":{\"action\":\"error\",\"target\":[],\"update_columns\":[]}}],\"dependencies\":[],\"ignored_fields\":{}}",
        "mapping_reference": "{\"target_groups\":[{\"group_id\":\"g1\",\"source_collection_id\":\"c1\",\"source_selector_id\":\"s1\",\"table_id\":\"t1\",\"field_mapping\":{\"c1.f1\":\"t1.c1\",\"c1.f2\":\"t1.c2\"},\"constants\":{},\"write_semantics\":\"plain_insert\",\"conflict_target_id\":null,\"update_column_ids\":[]}],\"dependencies\":[],\"ignored_fields\":{}}"
      }
    },
    {
      "demonstration_id": "semi_insert_ignore",
      "mode": "semi_structured",
      "input": "REQUEST: Add the listed products and ignore an item when its product ID already exists.\nSOURCE: c1/s1 at $[*], c1.f1=product id, c1.f2=description.\nDATA: [{\"product id\":\"P01\",\"description\":\"Paper\"}]\nDEMO SCHEMA: t1=products; t1.c1=product_id; t1.c2=description; t1.u1=PRIMARY KEY(t1.c1).",
      "outputs": {
        "direct": "INSERT INTO products(product_id, description) VALUES ('P01', 'Paper') ON CONFLICT(product_id) DO NOTHING;",
        "record": "{\"records\":[{\"table\":\"products\",\"operation\":\"insert_ignore\",\"values\":{\"product_id\":\"P01\",\"description\":\"Paper\"}}]}",
        "mapping_legacy": "{\"target_groups\":[{\"group_id\":\"g1\",\"source_collection\":\"collection_1\",\"source_rows\":\"$[*]\",\"table\":\"products\",\"field_mapping\":{\"product id\":\"product_id\",\"description\":\"description\"},\"constants\":{},\"action\":\"insert\",\"conflict\":{\"action\":\"do_nothing\",\"target\":[\"product_id\"],\"update_columns\":[]}}],\"dependencies\":[],\"ignored_fields\":{}}",
        "mapping_reference": "{\"target_groups\":[{\"group_id\":\"g1\",\"source_collection_id\":\"c1\",\"source_selector_id\":\"s1\",\"table_id\":\"t1\",\"field_mapping\":{\"c1.f1\":\"t1.c1\",\"c1.f2\":\"t1.c2\"},\"constants\":{},\"write_semantics\":\"insert_ignore\",\"conflict_target_id\":\"t1.u1\",\"update_column_ids\":[]}],\"dependencies\":[],\"ignored_fields\":{}}"
      }
    },
    {
      "demonstration_id": "semi_upsert_update",
      "mode": "semi_structured",
      "input": "REQUEST: Add the students; when a student ID exists, update only the supplied name and website.\nSOURCE: c1/s1 at $[*], c1.f1=student id, c1.f2=name, c1.f3=website.\nDATA: [{\"student id\":\"S001\",\"name\":\"Nguyen A\",\"website\":\"https://example.test\"}]\nDEMO SCHEMA: t1=students; t1.c1=student_id; t1.c2=name; t1.c3=website; t1.u1=PRIMARY KEY(t1.c1).",
      "outputs": {
        "direct": "INSERT INTO students(student_id, name, website) VALUES ('S001', 'Nguyen A', 'https://example.test') ON CONFLICT(student_id) DO UPDATE SET name=excluded.name, website=excluded.website;",
        "record": "{\"records\":[{\"table\":\"students\",\"operation\":\"upsert_update\",\"values\":{\"student_id\":\"S001\",\"name\":\"Nguyen A\",\"website\":\"https://example.test\"}}]}",
        "mapping_legacy": "{\"target_groups\":[{\"group_id\":\"g1\",\"source_collection\":\"collection_1\",\"source_rows\":\"$[*]\",\"table\":\"students\",\"field_mapping\":{\"student id\":\"student_id\",\"name\":\"name\",\"website\":\"website\"},\"constants\":{},\"action\":\"insert\",\"conflict\":{\"action\":\"do_update\",\"target\":[\"student_id\"],\"update_columns\":[\"name\",\"website\"]}}],\"dependencies\":[],\"ignored_fields\":{}}",
        "mapping_reference": "{\"target_groups\":[{\"group_id\":\"g1\",\"source_collection_id\":\"c1\",\"source_selector_id\":\"s1\",\"table_id\":\"t1\",\"field_mapping\":{\"c1.f1\":\"t1.c1\",\"c1.f2\":\"t1.c2\",\"c1.f3\":\"t1.c3\"},\"constants\":{},\"write_semantics\":\"upsert_update\",\"conflict_target_id\":\"t1.u1\",\"update_column_ids\":[\"t1.c2\",\"t1.c3\"]}],\"dependencies\":[],\"ignored_fields\":{}}"
      }
    },
    {
      "demonstration_id": "semi_parent_child",
      "mode": "semi_structured",
      "input": "REQUEST: Add the customer before the related order.\nSOURCE: c1/s1 at $.customers[*], c1.f1=customer id, c1.f2=name; c2/s2 at $.orders[*], c2.f1=order id, c2.f2=customer id, c2.f3=amount.\nDATA: {\"customers\":[{\"customer id\":\"C1\",\"name\":\"Minh\"}],\"orders\":[{\"order id\":\"O1\",\"customer id\":\"C1\",\"amount\":120}]}\nDEMO SCHEMA: t1=customers(t1.c1=customer_id,t1.c2=name,t1.u1=PK); t2=orders(t2.c1=order_id,t2.c2=customer_id,t2.c3=amount,t2.u1=PK), FK t2.c2->t1.c1.",
      "outputs": {
        "direct": "INSERT INTO customers(customer_id, name) VALUES ('C1', 'Minh');\nINSERT INTO orders(order_id, customer_id, amount) VALUES ('O1', 'C1', 120);",
        "record": "{\"records\":[{\"table\":\"customers\",\"operation\":\"insert\",\"values\":{\"customer_id\":\"C1\",\"name\":\"Minh\"}},{\"table\":\"orders\",\"operation\":\"insert\",\"values\":{\"order_id\":\"O1\",\"customer_id\":\"C1\",\"amount\":120}}]}",
        "mapping_legacy": "{\"target_groups\":[{\"group_id\":\"parent\",\"source_collection\":\"customers\",\"source_rows\":\"$.customers[*]\",\"table\":\"customers\",\"field_mapping\":{\"customer id\":\"customer_id\",\"name\":\"name\"},\"constants\":{},\"action\":\"insert\",\"conflict\":{\"action\":\"error\",\"target\":[],\"update_columns\":[]}},{\"group_id\":\"child\",\"source_collection\":\"orders\",\"source_rows\":\"$.orders[*]\",\"table\":\"orders\",\"field_mapping\":{\"order id\":\"order_id\",\"customer id\":\"customer_id\",\"amount\":\"amount\"},\"constants\":{},\"action\":\"insert\",\"conflict\":{\"action\":\"error\",\"target\":[],\"update_columns\":[]}}],\"dependencies\":[{\"before\":\"parent\",\"after\":\"child\"}],\"ignored_fields\":{}}",
        "mapping_reference": "{\"target_groups\":[{\"group_id\":\"parent\",\"source_collection_id\":\"c1\",\"source_selector_id\":\"s1\",\"table_id\":\"t1\",\"field_mapping\":{\"c1.f1\":\"t1.c1\",\"c1.f2\":\"t1.c2\"},\"constants\":{},\"write_semantics\":\"plain_insert\",\"conflict_target_id\":null,\"update_column_ids\":[]},{\"group_id\":\"child\",\"source_collection_id\":\"c2\",\"source_selector_id\":\"s2\",\"table_id\":\"t2\",\"field_mapping\":{\"c2.f1\":\"t2.c1\",\"c2.f2\":\"t2.c2\",\"c2.f3\":\"t2.c3\"},\"constants\":{},\"write_semantics\":\"plain_insert\",\"conflict_target_id\":null,\"update_column_ids\":[]}],\"dependencies\":[{\"before\":\"parent\",\"after\":\"child\"}],\"ignored_fields\":{}}"
      }
    },
